{
  "name": "la-taberna-nyaa-extractor",
  "version": "1.0.0",
  "description": "Information extractor and scheduler API for Nyaa.si anime torrents",
  "main": "src/app.js",
  "bin": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "test:cli": "node scripts/testScraper.js",
    "test:benchmark": "node scripts/benchmarkScraper.js",
    "build:exe": "node scripts/buildExe.js",
    "build:pkg": "pkg . --targets node18-win-x64 --out-path dist",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64 --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "nyaa",
    "scraper",
    "anime",
    "schedule",
    "torrent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "lru-cache": "^11.5.3",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
