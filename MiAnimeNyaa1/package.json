{
  "name": "mi-taberna-nyaa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "scripts/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"node server/server.js\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/tilt-neon": "^5.2.10",
    "@fontsource/yellowtail": "^5.2.8",
    "@tsparticles/engine": "3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "3.8.1",
    "animejs": "^3.2.2",
    "anitomy-js": "^5.4.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "color-thief-react": "^2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.383.0",
    "p-queue": "^9.3.3",
    "puppeteer": "^25.4.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.12",
    "rss-parser": "^3.13.0",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.lataberna.app",
    "productName": "La Taberna",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "scripts/**/*",
      "data/**/*",
      "public/**/*",
      "main.cjs",
      ".env",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
